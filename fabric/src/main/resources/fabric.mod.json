{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "A server-side mod for Fabric servers; players join with an unmodded client. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.",
	"authors": [
		"NR137"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_homepage}",
		"issues": "${mod_homepage}/issues"
	},
	"license": "${license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.nr137.playertitles.fabric.PlayerTitlesFabric"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
